# Release Signing Configuration Template
#
# Copy this file to keystore.properties (git-ignored) and fill with actual values.
#
# DO NOT commit keystore.properties or the .jks/.keystore file to Git.
#
# Example:
# storeFile=../kasirkita-release.jks
# storePassword=YOUR_KEYSTORE_PASSWORD
# keyAlias=kasirkita-release
# keyPassword=YOUR_KEY_PASSWORD

storeFile=../kasirkita-release.jks
storePassword=
keyAlias=kasirkita-release
keyPassword=
