<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+ (API 31+).
  Excludes sensitive local data from cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all DataStore preference files under files/datastore/ -->
        <exclude domain="file" path="datastore/" />

        <!-- Exclude Room database and associated WAL/SHM files -->
        <exclude domain="database" path="kasirkita.db" />
        <exclude domain="database" path="kasirkita.db-wal" />
        <exclude domain="database" path="kasirkita.db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all DataStore preference files under files/datastore/ -->
        <exclude domain="file" path="datastore/" />

        <!-- Exclude Room database and associated WAL/SHM files -->
        <exclude domain="database" path="kasirkita.db" />
        <exclude domain="database" path="kasirkita.db-wal" />
        <exclude domain="database" path="kasirkita.db-shm" />
    </device-transfer>
</data-extraction-rules>
